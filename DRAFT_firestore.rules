rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isBoundedStringArray(arr, maxLen) {
      return arr is list && arr.size() <= maxLen && (arr.size() == 0 || (arr[0] is string && arr[0].size() <= 64));
    }

    function isValidStudentProfile(data) {
      return data.keys().hasAll([
        'uid',
        'displayName',
        'className',
        'tokens',
        'totalXp',
        'tpLevel',
        'avgClarity',
        'avgIntonation',
        'completedParagraphs',
        'completedCheckpoints',
        'unlockedBadges',
        'unlockedAccessories',
        'equippedHat',
        'equippedTie',
        'equippedBack',
        'equippedGlasses',
        'rumusanAnswer',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'uid',
        'displayName',
        'className',
        'tokens',
        'totalXp',
        'tpLevel',
        'avgClarity',
        'avgIntonation',
        'completedParagraphs',
        'completedCheckpoints',
        'unlockedBadges',
        'unlockedAccessories',
        'equippedHat',
        'equippedTie',
        'equippedBack',
        'equippedGlasses',
        'rumusanAnswer',
        'updatedAt'
      ]) &&
      data.uid == request.auth.uid &&
      isValidId(data.uid) &&
      data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 60 &&
      data.className is string && data.className.size() >= 1 && data.className.size() <= 30 &&
      data.tokens is number && data.tokens >= 0 && data.tokens <= 100000 &&
      data.totalXp is number && data.totalXp >= 0 && data.totalXp <= 500000 &&
      data.tpLevel is number && data.tpLevel >= 1 && data.tpLevel <= 6 &&
      data.avgClarity is number && data.avgClarity >= 0 && data.avgClarity <= 100 &&
      data.avgIntonation is number && data.avgIntonation >= 0 && data.avgIntonation <= 100 &&
      isBoundedStringArray(data.completedParagraphs, 15) &&
      isBoundedStringArray(data.completedCheckpoints, 10) &&
      isBoundedStringArray(data.unlockedBadges, 20) &&
      isBoundedStringArray(data.unlockedAccessories, 30) &&
      data.equippedHat is string && data.equippedHat.size() >= 1 && data.equippedHat.size() <= 40 &&
      data.equippedTie is string && data.equippedTie.size() >= 1 && data.equippedTie.size() <= 40 &&
      data.equippedBack is string && data.equippedBack.size() >= 1 && data.equippedBack.size() <= 40 &&
      data.equippedGlasses is string && data.equippedGlasses.size() >= 1 && data.equippedGlasses.size() <= 40 &&
      data.rumusanAnswer is string && data.rumusanAnswer.size() <= 500 &&
      data.updatedAt == request.time;
    }

    function isValidReadingLog(data) {
      return data.keys().hasAll([
        'uid',
        'studentName',
        'paragraphId',
        'clarityScore',
        'intonationScore',
        'tokensEarned',
        'createdAt'
      ]) &&
      data.keys().hasOnly([
        'uid',
        'studentName',
        'paragraphId',
        'clarityScore',
        'intonationScore',
        'tokensEarned',
        'createdAt'
      ]) &&
      data.uid == request.auth.uid &&
      isValidId(data.uid) &&
      data.studentName is string && data.studentName.size() >= 1 && data.studentName.size() <= 60 &&
      data.paragraphId is string && data.paragraphId.size() >= 1 && data.paragraphId.size() <= 40 &&
      data.clarityScore is number && data.clarityScore >= 0 && data.clarityScore <= 100 &&
      data.intonationScore is number && data.intonationScore >= 0 && data.intonationScore <= 100 &&
      data.tokensEarned is number && data.tokensEarned >= 0 && data.tokensEarned <= 500 &&
      data.createdAt == request.time;
    }

    match /students/{studentId} {
      // Non-PII public leaderboard & own profile reads
      allow get: if isSignedIn() && isValidId(studentId) && resource.data.tpLevel >= 1;
      allow list: if isSignedIn() && resource.data.tpLevel >= 1 && resource.data.totalXp >= 0;

      allow create: if isVerifiedUser() &&
        isValidId(studentId) &&
        studentId == request.auth.uid &&
        isValidStudentProfile(incoming());

      allow update: if isVerifiedUser() &&
        isValidId(studentId) &&
        studentId == request.auth.uid &&
        isValidStudentProfile(incoming()) &&
        incoming().uid == existing().uid &&
        (
          // Action: Progress & Avatar Update
          incoming().diff(existing()).affectedKeys().hasOnly([
            'displayName',
            'className',
            'tokens',
            'totalXp',
            'tpLevel',
            'avgClarity',
            'avgIntonation',
            'completedParagraphs',
            'completedCheckpoints',
            'unlockedBadges',
            'unlockedAccessories',
            'equippedHat',
            'equippedTie',
            'equippedBack',
            'equippedGlasses',
            'rumusanAnswer',
            'updatedAt'
          ])
        );

      allow delete: if false;
    }

    match /reading_logs/{logId} {
      allow get: if isSignedIn() && isValidId(logId) && resource.data.uid == request.auth.uid;
      allow list: if isSignedIn() && resource.data.uid == request.auth.uid;

      allow create: if isVerifiedUser() &&
        isValidId(logId) &&
        isValidReadingLog(incoming()) &&
        exists(/databases/$(database)/documents/students/$(request.auth.uid));

      allow update, delete: if false;
    }
  }
}
